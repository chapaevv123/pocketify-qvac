{
  "name": "pocketify",
  "version": "1.0.0",
  "description": "Cloud to Pocket migration demo with real local QVAC ticket triage",
  "type": "module",
  "bin": { "pocketify": "./pocketify.mjs" },
  "scripts": {
    "test": "node --test tests/unit.test.mjs tests/browser-lab.test.mjs",
    "test:integration": "node --test tests/qvac.integration.test.mjs",
    "scan": "node pocketify.mjs scan examples/ticket-triage",
    "triage": "node pocketify.mjs triage",
    "eval": "node pocketify.mjs eval",
    "studio": "node studio/server.mjs",
    "build:showcase": "node scripts/build-showcase.mjs",
    "test:studio": "node --test tests/studio.test.mjs",
    "test:studio:integration": "node --test --test-force-exit tests/studio.integration.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@qvac/cli": "0.17.0",
    "@qvac/sdk": "0.22.0"
  }
}
